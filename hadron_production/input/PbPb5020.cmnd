! System: PbPb5020
HeavyIon:mode = 1
SoftQCD:nonDiffractive = on

Beams:idA = 1000822080
Beams:idB = 1000822080
Beams:frameType = 2
Beams:eA = 2510.      ! per-nucleon beam energy -> sqrt(s_NN) = 5020 GeV
Beams:eB = 2510.

PDF:pSet  = LHAPDF6:nCTEQ15FullNuc_208_82
PDF:pSetB = LHAPDF6:nCTEQ15FullNuc_208_82

! Cache Glauber fit from a previous run (speeds up init by ~30s)
HeavyIon:SigFitNGen = 0
HeavyIon:SigFitDefAvNDb = 0.98
HeavyIon:SigFitDefPar = 5.81,9.93,0.34
